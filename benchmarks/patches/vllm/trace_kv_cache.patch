+    # ── POLARIS trace helpers ────────────────────────────────────────────
+
+    def _polaris_trace_allocate(
+        self, request: Request, result: "KVCacheBlocks"
+    ) -> None:
+        """Emit SESSION_CREATE and BLOCK_ALLOC events for this allocation."""
+        rid = request.request_id
+        total_blocks = sum(len(g) for g in result.blocks)
+        old_total = self._polaris_session_blocks.get(rid, 0)
+
+        if rid not in self._polaris_seen_sessions:
+            _polaris_emit("SESSION_CREATE", rid, 0, 0)
+            self._polaris_seen_sessions.add(rid)
+
+        block_size = self.kv_cache_config.kv_cache_groups[0].block_size
+        if total_blocks > old_total:
+            for i in range(old_total, total_blocks):
+                token_start = i * block_size
+                _polaris_emit("BLOCK_ALLOC", rid, token_start, block_size)
+        elif total_blocks < old_total:
+            for _ in range(total_blocks, old_total):
+                _polaris_emit("BLOCK_FREE", rid, 0, 0)
+
+        self._polaris_session_blocks[rid] = total_blocks
+
+    def _polaris_trace_free(self, request: Request) -> None:
+        """Emit BLOCK_FREE and SESSION_DESTROY events."""
+        rid = request.request_id
+        total = self._polaris_session_blocks.pop(rid, 0)
+        if total == 0 and rid not in self._polaris_seen_sessions:
+            return
+        for _ in range(total):
+            _polaris_emit("BLOCK_FREE", rid, 0, 0)
+        _polaris_emit("SESSION_DESTROY", rid, 0, 0)
+        self._polaris_seen_sessions.discard(rid)
+
