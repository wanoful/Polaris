+# POLARIS KV trace collection for benchmark comparison.
+# Activated by POLARIS_TRACE=<output_path>.
+_POLARIS_TRACE_PATH = os.environ.get("POLARIS_TRACE", "")
+_POLARIS_TRACE_FD = None
+_POLARIS_SESSION_TOKENS: dict[str, int] = {}
+_POLARIS_SEEN: set[str] = set()
+_POLARIS_BLOCK_TOKENS = int(os.environ.get("POLARIS_TRACE_BLOCK_TOKENS", "16"))
+
+
+def _polaris_trace_fd():
+    global _POLARIS_TRACE_FD
+    if _POLARIS_TRACE_FD is None and _POLARIS_TRACE_PATH:
+        _POLARIS_TRACE_FD = open(_POLARIS_TRACE_PATH, "w")
+        _POLARIS_TRACE_FD.write(
+            "timestamp_ns,op,session_id,token_start,token_count\n"
+        )
+    return _POLARIS_TRACE_FD
+
+
+def _polaris_emit(
+    op: str, session_id: str, token_start: int, token_count: int
+) -> None:
+    fd = _polaris_trace_fd()
+    if fd is None:
+        return
+    fd.write(f"{time.time_ns()},{op},{session_id},{token_start},{token_count}\n")
+    fd.flush()
+
+
+def _polaris_req_id(req: "Req") -> str:
+    return str(getattr(req, "rid", id(req)))
+
+
+def _polaris_trace_reserve(req: "Req", token_count: int) -> None:
+    if token_count <= 0:
+        return
+
+    rid = _polaris_req_id(req)
+    old_total = _POLARIS_SESSION_TOKENS.get(rid, 0)
+
+    if rid not in _POLARIS_SEEN:
+        _polaris_emit("SESSION_CREATE", rid, 0, 0)
+        _POLARIS_SEEN.add(rid)
+
+    for start in range(0, token_count, _POLARIS_BLOCK_TOKENS):
+        chunk = min(_POLARIS_BLOCK_TOKENS, token_count - start)
+        _polaris_emit("BLOCK_RESERVE", rid, old_total + start, chunk)
+
+    _POLARIS_SESSION_TOKENS[rid] = old_total + token_count
+
+
+def _polaris_trace_extend(reqs: list["Req"], extend_lens: list[int]) -> None:
+    for req, extend_len in zip(reqs, extend_lens):
+        _polaris_trace_reserve(req, int(extend_len))
+
+
+def _polaris_trace_decode(reqs: list["Req"], token_per_req: int) -> None:
+    for req in reqs:
+        _polaris_trace_reserve(req, int(token_per_req))
+
+
+def _polaris_trace_release(req: "Req") -> None:
+    rid = _polaris_req_id(req)
+    total = _POLARIS_SESSION_TOKENS.pop(rid, 0)
+    if total == 0 and rid not in _POLARIS_SEEN:
+        return
+
+    num_blocks = (total + _POLARIS_BLOCK_TOKENS - 1) // _POLARIS_BLOCK_TOKENS
+    for _ in range(num_blocks):
+        _polaris_emit("BLOCK_RELEASE", rid, 0, 0)
+    _polaris_emit("SESSION_DESTROY", rid, 0, 0)
+    _POLARIS_SEEN.discard(rid)
+
+
